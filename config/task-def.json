{
  "containerDefinitions": [
    {
      "name": "petclinic-container",
      "image": "721212970627.dkr.ecr.us-east-1.amazonaws.com/spring-petclinic:latest",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [],
      "mountPoints": [],
      "volumesFrom": [],
      "systemControls": []
    }
  ],
  "family": "petclinic-task",
  "executionRoleArn": "arn:aws:iam::721212970627:role/ecsTaskExecutionRolePetclinic",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024"
}